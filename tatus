[32m+[m[32m# The default value is: NO.[m
[32m+[m[32m# This tag requires that the tag GENERATE_HTMLHELP is set to YES.[m
[32m+[m
[32m+[m[32mBINARY_TOC             = NO[m
[32m+[m
[32m+[m[32m# The TOC_EXPAND flag can be set to YES to add extra items for group members to[m
[32m+[m[32m# the table of contents of the HTML help documentation and to the tree view.[m
[32m+[m[32m# The default value is: NO.[m
[32m+[m[32m# This tag requires that the tag GENERATE_HTMLHELP is set to YES.[m
[32m+[m
[32m+[m[32mTOC_EXPAND             = NO[m
[32m+[m
[32m+[m[32m# The SITEMAP_URL tag is used to specify the full URL of the place where the[m
