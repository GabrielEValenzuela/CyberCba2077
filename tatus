[32m+[m[32m# The default value is: org.doxygen.Publisher.[m
[32m+[m[32m# This tag requires that the tag GENERATE_DOCSET is set to YES.[m
[32m+[m
[32m+[m[32mDOCSET_PUBLISHER_ID    = org.doxygen.Publisher[m
[32m+[m
[32m+[m[32m# The DOCSET_PUBLISHER_NAME tag identifies the documentation publisher.[m
