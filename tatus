[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# 📐 Compilación y build[m
[32m+[m
[32m+[m[32mEste proyecto utiliza **CMake** como sistema de build.[m
[32m+[m
[32m+[m[32m## 🔧 Requisitos[m
[32m+[m
[32m+[m[32m- Compilador compatible con **C++17** (recomendado: GCC ≥ 11 / Clang ≥ 14)[m
[32m+[m[32m- **CMake ≥ 3.16**[m
[32m+[m[32m- **raylib** (incluida / provista por el template del curso)[m
[32m+[m[32m- Git[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## 🛠 Instrucciones de compilación[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mgit clone <repository-url>[m
[32m+[m[32mcd cyberpunk-cordoba-2077[m
[32m+[m[32mmkdir build[m
[32m+[m[32mcd build[m
[32m+[m[32mcmake ..[m
[32m+[m[32mcmake --build .[m
[32m+[m[32m````[m
[32m+[m
[32m+[m[32mPara ejecutar:[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m./cyberpunk2077[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## 🧪 Modo Debug[m
[32m+[m
[32m+[m[32mPara compilar en modo debug:[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mcmake -DCMAKE_BUILD_TYPE=Debug ..[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mRecomendamos fuertemente compilar con:[m
[32m+[m
[32m+[m[32m* Address Sanitizer[m
[32m+[m[32m* Undefined Behavior Sanitizer[m
[32m+[m
[32m+[m[32mEjemplo:[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mcmake -DCMAKE_CXX_FLAGS="-fsanitize=address,undefined -g" ..[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mPorque en 2077, los memory bugs se pagan caro.[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m# 🧪 Cómo contribuir[m
[32m+[m
[32m+[m[32mEste repositorio sigue un flujo de trabajo profesional.[m
[32m+[m
[32m+[m[32m## 🔀 Modelo de ramas[m
[32m+[m
[32m+[m[32m* `main` → versión estable[m
[32m+[m[32m* `dev` → rama de integración[m
[32m+[m[32m* Ramas por feature → `feature/<nombre>`[m
[32m+[m
[32m+[m[32mEjemplo:[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mgit checkout -b feature/inventory-list[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## 📌 Pull Requests[m
[32m+[m
[32m+[m[32mCada aporte debe:[m
