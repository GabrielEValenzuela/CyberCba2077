[32m+[m[32m# This tag requires that the tag GENERATE_HTML is set to YES.[m
[32m+[m
[32m+[m[32mHTML_CODE_FOLDING      = YES[m
[32m+[m
[32m+[m[32m# If the HTML_COPY_CLIPBOARD tag is set to YES then doxygen will show an icon in[m
[32m+[m[32m# the top right corner of code and text fragments that allows the user to copy[m
