[32m+[m[32m# This tag requires that the tag GENERATE_DOCSET is set to YES.[m
[32m+[m
[32m+[m[32mDOCSET_FEEDURL         =[m
[32m+[m
[32m+[m[32m# This tag specifies a string that should uniquely identify the documentation[m
[32m+[m[32m# set bundle. This should be a reverse domain-name style string, e.g.[m
[32m+[m[32m# com.mycompany.MyDocSet. Doxygen will append .docset to the name.[m
