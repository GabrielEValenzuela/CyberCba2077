[32m+[m[32m# https://doc.qt.io/archives/qt-4.8/qthelpproject.html#virtual-folders).[m
[32m+[m[32m# The default value is: doc.[m
[32m+[m[32m# This tag requires that the tag GENERATE_QHP is set to YES.[m
[32m+[m
