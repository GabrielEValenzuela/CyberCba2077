[32m+[m[32m# ~/Library/Developer/Shared/Documentation/DocSets so that Xcode will find it at[m
[32m+[m[32m# startup. See https://developer.apple.com/library/archive/featuredarticles/Doxy[m
[32m+[m[32m# genXcode/_index.html for more information.[m
[32m+[m[32m# The default value is: NO.[m
