{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "vcpkg-base",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "dev",
            "displayName": "Development (Debug + tests)",
            "inherits": "vcpkg-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CYBERCBA_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "vcpkg-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "asan",
            "displayName": "Debug + ASan/UBSan",
            "inherits": "vcpkg-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "CYBERCBA_BUILD_TESTS": "ON",
                "CYBERCBA_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "vcpkg-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CYBERCBA_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "ci",
            "displayName": "CI (warnings-as-errors + tests)",
            "inherits": "vcpkg-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ci",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "CYBERCBA_BUILD_TESTS": "ON",
                "CYBERCBA_WARNINGS_AS_ERRORS": "ON",
                "CYBERCBA_ENABLE_CLANG_TIDY": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "dev" },
        { "name": "debug", "configurePreset": "debug" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "release", "configurePreset": "release" },
        { "name": "ci", "configurePreset": "ci" }
    ],
    "testPresets": [
        { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
        { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
        { "name": "ci", "configurePreset": "ci", "output": { "outputOnFailure": true } }
    ]
}
